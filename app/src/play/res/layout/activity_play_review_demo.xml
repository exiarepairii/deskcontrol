<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playReviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/playReviewToolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:minHeight="64dp"
        android:paddingHorizontal="16dp"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurfaceVariant"
        app:title="@string/play_review_demo_title"
        app:titleTextAppearance="?attr/textAppearanceHeadlineSmall"
        app:titleTextColor="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_review_demo_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <FrameLayout
            android:id="@+id/playReviewDisplay"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="16dp"
            android:background="#202124"
            android:padding="16dp">

            <TextView
                android:id="@+id/playReviewResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/control_mode_callout_bg"
                android:padding="20dp"
                android:text="@string/play_review_demo_target"
                android:textColor="#FFFFFF"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <View
                android:id="@+id/playReviewCursor"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/cursor_arrow" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/play_review_demo_touchpad_label"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <View
            android:id="@+id/playReviewTouchpad"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/touchpad_area_bg"
            android:contentDescription="@string/play_review_demo_touchpad_label"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
